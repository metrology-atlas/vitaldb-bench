# Copy to local.env (which git ignores) and edit for your machine.
VITALDB_ROOT="/path/to/vitaldb-a-high-fidelity-multi-parameter-vital-signs-database-in-surgical-patients-1.0.0"
VITALDB_PYTHON="python"   # the Python that has vitaldb-bench and its dependencies installed
VITALDB_WORK="/path/to/work"           # per-case output of the scan drivers (never published); bench/cases_*.json
VITALDB_TEST_DBS="/path/to/test_dbs"   # where t30_out.sh copies finished builds
VITALDB_PYTHONPATH="/path/to/TimeNet/packages/timenet-connectors/src:/path/to/physiosync"   # scan drivers; if not pip-installed
