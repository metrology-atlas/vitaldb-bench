# Copy to local.env (which git ignores) and edit for your machine.
VITALDB_ROOT="/path/to/vitaldb-a-high-fidelity-multi-parameter-vital-signs-database-in-surgical-patients-1.0.0"
VITALDB_PYTHON="python"   # the Python that has vitaldb-bench and its dependencies installed
